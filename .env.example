# Supabase project API settings. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Direct or session-pooler Postgres URL used only by server code and Drizzle.
# URL-encode special characters in credentials.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Optional server-only HTTP bridge for the Claude MCP adapter.
CLAUDE_MCP_ENDPOINT=http://localhost:8787/mcp/tools
CLAUDE_MCP_AUTH_TOKEN=

# Server-only enrichment and background workflow credentials.
APOLLO_API_KEY=
FIRECRAWL_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
