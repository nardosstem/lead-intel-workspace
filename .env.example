# Supabase project API settings. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep 0 for an internal deployment; set 1 only when self-service sign-up is intended.
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=0
# Stable deployment secret for multi-instance Server Action compatibility.
# Leave empty for single-instance local development.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only Postgres URL. For Vercel/serverless runtime, prefer Supabase's
# transaction pooler (port 6543), for example:
# postgresql://postgres.<project-ref>:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Use the direct Supabase connection (port 5432) when running migrations.
# URL-encode special characters in credentials.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Default AI provider. Gemini is preferred when GEMINI_API_KEY is configured;
# Claude MCP remains the fallback. Keep Gemini private-data access disabled for
# free-tier projects because Google may use free-tier content for improvement.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_ENABLED=1
GEMINI_ALLOW_PRIVATE_DATA=0
# Set either switch to 0 for an emergency provider-spend stop.
LEAD_INGESTION_ENABLED=1
AI_ACTIONS_ENABLED=1

# Optional server-only HTTP bridge for the Claude MCP adapter.
CLAUDE_MCP_ENDPOINT=http://localhost:8787/mcp/tools
CLAUDE_MCP_AUTH_TOKEN=
# Explicit opt-in before contact notes or other private workspace data can be
# sent to the Claude MCP bridge.
CLAUDE_MCP_ALLOW_PRIVATE_DATA=0

# Optional server-only Supabase Admin key used to send organization invitations.
# Never expose this as NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only enrichment and background workflow credentials.
APOLLO_API_KEY=
FIRECRAWL_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only when running the local Inngest Dev Server.
INNGEST_DEV=

# Optional daily news-signal scan defaults. Discovery uses GDELT/RSS and does
# not require another news API key. Keep budgets low until provider costs are
# measured in staging.
NEWS_SCAN_ENABLED=0
NEWS_SCAN_CRON=0 7 * * *
NEWS_SCAN_MAX_COMPANIES=100
NEWS_SCAN_MAX_ARTICLES_PER_COMPANY=3
# UTC per-organization provider budgets. Keep conservative until usage is measured.
LEAD_INGESTION_DAILY_LIMIT=25
NEWS_SCAN_DAILY_LIMIT=1
AI_ACTION_DAILY_LIMIT=100
