# Supabase project API settings. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Stable deployment secret for multi-instance Server Action compatibility.
# Leave empty for single-instance local development.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Direct or session-pooler Postgres URL used only by server code and Drizzle.
# URL-encode special characters in credentials.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Optional server-only HTTP bridge for the Claude MCP adapter.
CLAUDE_MCP_ENDPOINT=http://localhost:8787/mcp/tools
CLAUDE_MCP_AUTH_TOKEN=

# Optional server-only Supabase Admin key used to send organization invitations.
# Never expose this as NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only enrichment and background workflow credentials.
APOLLO_API_KEY=
FIRECRAWL_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only when running the local Inngest Dev Server.
INNGEST_DEV=

# Optional weekly news-signal scan defaults. Discovery uses GDELT/RSS and does
# not require another news API key. Keep budgets low until provider costs are
# measured in staging.
NEWS_SCAN_ENABLED=0
NEWS_SCAN_CRON=0 7 * * 1
NEWS_SCAN_MAX_COMPANIES=100
NEWS_SCAN_MAX_ARTICLES_PER_COMPANY=3
